#找最大数字
num = [2,8,1,6,9,3]
b = num[0]
for n in num:
    if n > b:
        b = n 

print(f'The biggest num is {b}')


# 计算 平均分
score = [80,75,90,60,100]
count_n = len(score)
total = 0 
for s in score:
    total += s 

print(f"The total is {total}")
av = total / count_n
print(f"The average is {av}")

#超市清单程序
buy_l =[]
while True:

    thing = input('what do you want to buy today(enter done to finish)')
    if thing != "done":
        buy_l.append(thing)
    else:
        break
print('Your shooping list: ')
for b in buy_l:
    print(b)

