# Movie_ticket
class MovieTicket:
    def __init__(self):
        self.movies = {
    "Avatar": 15,
    "Barbie": 12,
    "Oppenheimer": 18,
    "Spider-Man": 14
}
        
    def get_price(self,movie):
     return self.movies.get(movie)
       
        
    def add_movie(self,movie,price):
        self.movies[movie] = price
    
    



#Test document
import unittest
from movie_ticket import MovieTicket
class Testmovie(unittest.TestCase):
    def setUp(self):
        self.ticket = MovieTicket()
    
    def test_get_price(self):
        result = self.ticket.get_price('Avatar')
        self.assertEqual(result,15)

    def test_none_movie(self):
        result1 = self.ticket.get_price("Aminate")
        self.assertIsNone(result1)

    def test_add_movie(self):
        self.ticket.add_movie('Titanci',16)
        result2 = self.ticket.get_price('Titanci')
        self.assertEqual(result2,16)

        

if __name__ == "__main__":
    unittest.main()
