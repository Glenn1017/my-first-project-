#练习1
def converter(currency):
    rates = {
  "usd": 0.14,
  "eur": 0.13,
  "jpy": 21.5
}
    def convert_amount(amount):
        return amount * rates[currency]
    
    return convert_amount

to_usd = converter("usd")
print(to_usd(100))

