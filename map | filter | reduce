from functools import reduce
playlist = [('What Was I Made For?', 3.42), ('Just Like That', 5.05), ('Song 3', 6.55), ('Leave The Door Open', 4.02), ('I Can\'t Breath', 4.47), ('Bad Guy', 3.14)]

def filter_five(song):
  if song[1]> 5:
    return song
fs = filter(filter_five,playlist)

def translate_time(song):
  return song[1] * 60

mp = map(translate_time,playlist)
print(list(mp))
seconds = list(map(translate_time, playlist))
def total_time(total,current):
  return total + current

add_durations = reduce(total_time,seconds)
print(round(add_durations))

