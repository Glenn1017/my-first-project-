from functools import  reduce
movies = [
  ("Spider-Man", 2.2),
  ("Inside Out", 1.6),
  ("Oppenheimer", 3.0),
  ("Barbie", 1.9),
  ("Interstellar", 2.8)
]
def over_two(movie):
    if movie[1] > 2:
        return movie
    
tf = filter(over_two,movies)

def hour_minute(movie):
    return movie[1] * 60

mh = map(hour_minute,movies)


def add_minuter(total,currern):
    return total + currern

rm = reduce(add_minuter,mh)
print(round(rm))

