#从另一个文档导入
import unittest
from test import reverse_string
from test import capitalize_string,is_capitalized

class TeststringUtils(unittest.TestCase):
    def test_reverse(self):
        result = reverse_string([1,2])
        self.assertEqual(result,[2,1])


    def test_cap(self):
        result1 = capitalize_string("smoke")
        self.assertEqual(result1,"Smoke")

    def test_is(self):
        result2 = is_capitalized("hello")
        self.assertTrue(result2)
        
if __name__ == "__main__":
    unittest.main()
